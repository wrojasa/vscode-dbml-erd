{
  "name": "vscode-dbml-erd",
  "displayName": "DBML ER Diagrams",
  "description": "Render .dbml files and ```dbml code blocks as interactive entity-relationship diagrams with orthogonal, dbdiagram.io-style routing. Edit tables, columns, relationships and areas on the canvas; every change is written back to the text.",
  "version": "0.1.0",
  "publisher": "wrojasa",
  "author": "Wilmar Rojas Avendaño",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrojasa/vscode-dbml-erd.git"
  },
  "bugs": {
    "url": "https://github.com/wrojasa/vscode-dbml-erd/issues"
  },
  "homepage": "https://github.com/wrojasa/vscode-dbml-erd#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "dbml",
    "erd",
    "entity relationship",
    "database",
    "dbdiagram",
    "diagram"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#20479e",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      },
      {
        "scopeName": "markdown.dbml.codeblock",
        "path": "./syntaxes/dbml.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.dbml": "dbml"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "dbmlErd.editor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.dbml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dbmlErd.openPreview",
        "title": "%cmd.openPreview%",
        "category": "DBML ERD",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dbmlErd.openPreview",
          "when": "editorLangId == dbml || editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dbmlErd.openPreview",
          "when": "editorLangId == dbml || editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "DBML ER Diagrams",
      "properties": {
        "dbmlErd.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Español"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "test:vscode": "node test/vscode/run.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "elkjs": "^0.11.1",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
